rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Consigliato: usare custom claim admin=true sul Firebase user admin.
    // In alternativa gestire lista UID admin lato backend/Worker, non nel frontend.
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isPublicActive() {
      return resource.data.status == 'ACTIVE' && resource.data.visibility == 'PUBLIC';
    }

    match /wildu_media_tags/{tagId} {
      allow read: if isAdmin() || isPublicActive();
      allow create, update, delete: if isAdmin();
    }

    match /wildu_media_catalog/{mediaId} {
      allow read: if isAdmin() || isPublicActive();
      allow create, update, delete: if isAdmin();
    }
  }
}
