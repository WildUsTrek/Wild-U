rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Sostituire con la logica admin reale già usata nel progetto.
    function isAdmin() {
      return signedIn();
    }

    match /wildu_media_tags/{tagId} {
      allow read: if resource.data.status == 'ACTIVE' && resource.data.visibility == 'PUBLIC';
      allow write: if isAdmin();
    }

    match /wildu_media_catalog/{mediaId} {
      allow read: if resource.data.status == 'ACTIVE' && resource.data.visibility == 'PUBLIC';
      allow write: if isAdmin();
    }

    match /wildu_media_runtime/{docId} {
      allow read: if docId == 'public_versions';
      allow write: if isAdmin();
    }
  }
}
