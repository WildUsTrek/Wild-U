rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Nuova collection ruoli dedicata SOLO al modulo mappa.
    // Crea a mano un documento wildu_map_roles/{uid} con:
    // { canWriteMap: true, role: "ADMIN" }
    // oppure { canWriteMap: true, role: "PARTNER" }
    function mapRolePath() {
      return /databases/$(database)/documents/wildu_map_roles/$(request.auth.uid);
    }

    function canWriteMap() {
      return signedIn()
        && exists(mapRolePath())
        && get(mapRolePath()).data.canWriteMap == true;
    }

    function isPublicActiveResource() {
      return resource.data.status == "ACTIVE" && resource.data.visibility == "PUBLIC";
    }

    function isPublicActiveRequest() {
      return request.resource.data.status in ["ACTIVE", "HIDDEN"]
        && request.resource.data.visibility == "PUBLIC";
    }

    function isValidArea() {
      return isPublicActiveRequest()
        && request.resource.data.areaSlug is string
        && request.resource.data.title is string
        && request.resource.data.centerLat is number
        && request.resource.data.centerLng is number
        && request.resource.data.defaultZoom is number;
    }

    function isValidWaypoint() {
      return isPublicActiveRequest()
        && request.resource.data.areaSlug is string
        && request.resource.data.title is string
        && request.resource.data.lat is number
        && request.resource.data.lng is number;
    }

    function isValidTrack() {
      return isPublicActiveRequest()
        && request.resource.data.areaSlug is string
        && request.resource.data.title is string
        && request.resource.data.fileType == "GPX";
    }

    match /wildu_map_roles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || canWriteMap());
      allow create, update, delete: if false; // gestisci ruoli da Console o backend admin, non dal client.
    }

    match /wildu_map_areas/{areaId} {
      allow get, list: if canWriteMap() || isPublicActiveResource();
      allow create, update: if canWriteMap() && isValidArea();
      allow delete: if false;
    }

    match /wildu_map_waypoints/{waypointId} {
      allow get, list: if canWriteMap() || isPublicActiveResource();
      allow create, update: if canWriteMap() && isValidWaypoint();
      allow delete: if false;
    }

    match /wildu_map_tracks/{trackId} {
      allow get, list: if canWriteMap() || isPublicActiveResource();
      allow create, update: if canWriteMap() && isValidTrack();
      allow delete: if false;
    }
  }
}
