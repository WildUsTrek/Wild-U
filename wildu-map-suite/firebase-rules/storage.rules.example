rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    // Versione MVP: scrive solo chi è autenticato.
    // Per produzione più stretta, usa custom claims Firebase Auth, gateway,
    // oppure una regola avanzata collegata a un documento ruoli.
    function canUploadMapTrack() {
      return signedIn();
      // Produzione consigliata:
      // return signedIn() && request.auth.token.canWriteMap == true;
    }

    match /wildu-map-tracks/{areaSlug}/{fileName} {
      allow read: if true;
      allow write: if canUploadMapTrack()
        && request.resource.size < 15 * 1024 * 1024
        && fileName.matches('.*\\.gpx$');
    }
  }
}
